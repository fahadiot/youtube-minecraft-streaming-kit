# Copy this file to ".env" and fill in your own values.
# Never commit your real ".env" file - it is already ignored by .gitignore.

# --- YouTube Data API ---
GOOGLE_API_KEY=your-youtube-data-api-key
CHANNEL_ID=your-youtube-channel-id
VIDEO_ID=your-live-video-id

# --- Exaroton (Minecraft server host) ---
EXAROTON_API_TOKEN=your-exaroton-api-token
EXAROTON_SERVER_ID=your-exaroton-server-id

# --- Feature toggles (true/false) ---
# Kill all players whenever a new subscriber joins
ENABLE_KILL_ON_SUB=true
# Summon a creeper whenever the video gets a new like
ENABLE_CREEPER_ON_LIKE=true
# Keep resetting everyone's spawn point to their current location each cycle
ENABLE_SPAWN_RESET=true

# --- Optional ---
# In-game username the creeper should spawn near. Defaults to all players.
TARGET_PLAYER=@a
# How often (seconds) to check YouTube for new subs/likes. Default: 30
POLL_INTERVAL_SECONDS=30
